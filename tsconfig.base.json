{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@nexora/ui/*": ["packages/ui/*"],
      "@nexora/hooks/*": ["packages/hooks/*"],
      "@nexora/types/*": ["packages/types/*"],
      "@nexora/utils/*": ["packages/utils/*"]
    }
  }
}
